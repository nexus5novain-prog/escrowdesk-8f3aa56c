# Telegram
TELEGRAM_BOT_TOKEN=replace-with-the-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret
PORT=8787
PUBLIC_WEBHOOK_URL=https://bot.example.com/telegram/webhook

# Wallet service: the bot requests addresses and settlement actions here.
WALLET_SERVICE_URL=https://wallet-provider.example.com
WALLET_SERVICE_API_KEY=replace-with-wallet-service-key
WALLET_WEBHOOK_SECRET=replace-with-wallet-webhook-secret
SUPPORTED_ASSETS=BTC,LTC

# Official Telegram destinations; leave blank until channels exist.
DEALS_CHANNEL_ID=
UPDATES_CHANNEL_URL=
BOT_CHANNEL_URL=
